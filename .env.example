# Local Ollama provider. Remove or leave both Ollama values blank for no-LLM mode.
REPOMIND_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:14b
OLLAMA_REQUEST_TIMEOUT_SECONDS=120

# Optional OpenAI-compatible provider. Set REPOMIND_LLM_PROVIDER=openai-compatible to use it.
REPOMIND_LLM_BASE_URL=
REPOMIND_LLM_MODEL=
REPOMIND_LLM_API_KEY=
REPOMIND_PYTHON_SERVICE_URL=http://localhost:8000
